{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "phoneNumber": {
          ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 20 && newData.val().matches(/^[+0-9(). -]+$/)"
        },
        "address": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$petId": {
          ".write": "auth != null && auth.uid === $uid && (newData.exists() || !root.child('petBookings').child($uid).child($petId).hasChildren())",
          ".validate": "newData.hasChildren(['ownerId', 'name', 'species', 'breed', 'age', 'size', 'gender', 'notes', 'imageURL'])",
          "ownerId": {
            ".validate": "newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "species": {
            ".validate": "newData.val() === 'Chó' || newData.val() === 'Mèo' || newData.val() === 'Khác'"
          },
          "breed": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "age": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && newData.val() % 1 === 0"
          },
          "size": {
            ".validate": "newData.val() === 'Nhỏ' || newData.val() === 'Vừa' || newData.val() === 'Lớn'"
          },
          "gender": {
            ".validate": "newData.val() === 'Cái' || newData.val() === 'Đực' || newData.val() === 'Không rõ'"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "imageURL": {
            ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === '' || newData.val().beginsWith('https://res.cloudinary.com/'))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "petBookings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "services": {
      ".read": "auth != null",
      "$serviceId": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'manager' && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'category', 'description', 'price', 'duration', 'active', 'imageURL', 'revision'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999999999 && newData.val() % 1 === 0"
        },
        "duration": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 600 && newData.val() % 1 === 0"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "imageURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === '' || newData.val().beginsWith('https://res.cloudinary.com/'))"
        },
        "revision": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 0) || (data.exists() && newData.val() === data.val() + 1))"
        },
        "discountPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0 && (newData.val() === 0 || (newData.parent().hasChildren(['promotionStart', 'promotionEnd']) && newData.parent().child('promotionStart').val() <= newData.parent().child('promotionEnd').val()))"
        },
        "promotionStart": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "promotionEnd": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
