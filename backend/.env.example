# Local MySQL settings shared by Docker Compose and the Spring docker profile.
# Copy to .env on a new machine and choose passwords before first startup.
MYSQL_PORT=3306
MYSQL_DATABASE=pet_shop
MYSQL_USER=pawpal
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# Firebase master data + token authentication for mobile. Server credentials only.
PAWPAL_FIREBASE_ENABLED=false
PAWPAL_FIREBASE_PROJECT_ID=pawpal-e40a5
PAWPAL_FIREBASE_DATABASE_URL=https://pawpal-e40a5-default-rtdb.asia-southeast1.firebasedatabase.app
# Absolute path outside the repositories; alternatively use GOOGLE_APPLICATION_CREDENTIALS.
PAWPAL_FIREBASE_CREDENTIALS_FILE=
# Unique per independent MySQL database; Start-PawPal.ps1 generates this once.
# Replicas sharing the same SQL database must keep the same value.
PAWPAL_FIREBASE_BOOKING_SCOPE=local-change-me
